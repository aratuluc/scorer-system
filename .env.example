# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' (or use .env.development / .env.production as needed):
#   cp .env.example .env
#
# Vite Frontend (client) reads any variables prefixed with 'VITE_'.
# FastAPI Backend (server) reads variables via server/config.py.
# Docker Compose uses the root .env file for variable substitution.
# ==============================================================================

# --- Application Environment ---
# Controls application mode ('development' or 'production')
APP_ENV=development

# --- Database Configuration (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=scorer_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# For Docker Compose (service name 'db'):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# For local development outside Docker (localhost):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# --- Backend API Configuration ---
API_PORT=8000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://predict.arat.dev,https://api.arat.dev

# --- Admin Authentication ---
ADMIN_USERNAME=admin
ADMIN_PWD=change_me_in_production
# Secret key used for signing JWT access tokens (generate with: openssl rand -hex 32)
ADMIN_SECRET=change_me_to_a_long_random_secret_key

# --- Notifications (Optional) ---
# NOTIFICATION_URL=https://your-webhook-or-notification-service.com/notify

# --- Frontend Client Configuration (Vite) ---
# Base URL for the FastAPI backend used by the React client.
# Development default: http://localhost:8000
# Production default:  https://api.arat.dev
VITE_API_BASE_URL=http://localhost:8000
